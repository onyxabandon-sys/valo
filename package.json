{
  "name": "valet-pos",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "android:device": "powershell -ExecutionPolicy Bypass -File scripts/run-android.ps1",
    "ios": "react-native run-ios",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:seed": "convex run seedDemoData:seedDemoData --push",
    "typecheck": "tsc --noEmit",
    "test:features": "tsx scripts/feature-check.ts",
    "test:e2e": "tsx scripts/e2e-check.ts",
    "test:release": "tsx scripts/release-check.ts",
    "test:golive": "tsx scripts/golive-check.ts",
    "verify": "npm run typecheck && npm run test:features && npm run test:e2e && npm run test:release && npm run test:golive"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.18.9",
    "@react-navigation/native": "^7.3.9",
    "@react-navigation/native-stack": "^7.18.1",
    "@tanstack/react-query": "^5.101.2",
    "convex": "^1.42.2",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "^3.0.2",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.26.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.2.79",
    "tsx": "^4.20.5",
    "typescript": "^5.5.4"
  }
}
