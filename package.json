{
  "name": "valet-pos",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "start": "react-native start",
    "android": "expo run:android",
    "android:device": "powershell -ExecutionPolicy Bypass -File scripts/run-android.ps1",
    "ios": "expo run:ios",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:seed": "convex run seedDemoData:seedDemoData --push",
    "typecheck": "tsc --noEmit",
    "typecheck:convex": "tsc --noEmit -p tsconfig.convex-tests.json",
    "test:posthog": "tsx scripts/posthog-check.ts",
    "test:features": "tsx scripts/feature-check.ts",
    "test:report-snapshot": "tsx scripts/report-snapshot-check.ts",
    "test:device-assignment": "tsx scripts/device-assignment-check.ts",
    "test:print-slip": "tsx scripts/print-slip-check.ts",
    "test:e2e": "tsx scripts/e2e-check.ts",
    "test:release": "tsx scripts/release-check.ts",
    "test:convex": "vitest run --config vitest.config.mts",
    "test:security": "npm audit --audit-level=high",
    "test:golive": "tsx scripts/golive-check.ts",
    "verify": "npm run typecheck && npm run typecheck:convex && npm run test:convex && npm run test:features && npm run test:report-snapshot && npm run test:device-assignment && npm run test:print-slip && npm run test:e2e && npm run test:release && npm run test:security && npm run test:golive && npm run test:posthog"
  },
  "dependencies": {
    "@better-auth/core": "1.6.29",
    "@better-auth/expo": "1.6.29",
    "@convex-dev/better-auth": "0.12.5",
    "@posthog/core": "1.55.2",
    "@posthog/react-native-plugin": "2.12.0",
    "@react-native-vector-icons/material-design-icons": "13.0.0",
    "@react-navigation/bottom-tabs": "^7.18.9",
    "@react-navigation/native": "^7.3.9",
    "@react-navigation/native-stack": "^7.18.1",
    "@tanstack/react-query": "^5.101.2",
    "better-auth": "1.6.29",
    "convex": "^1.42.2",
    "expo": "54.0.37",
    "expo-file-system": "19.0.24",
    "expo-linking": "8.0.12",
    "expo-network": "8.0.8",
    "expo-secure-store": "15.0.8",
    "expo-sharing": "14.0.8",
    "expo-web-browser": "15.0.11",
    "fflate": "0.8.3",
    "posthog-react-native": "4.78.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "2.28.0",
    "react-native-safe-area-context": "5.6.0",
    "react-native-screens": "4.16.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.81.5",
    "@react-native/metro-config": "0.81.5",
    "@types/node": "^26.1.1",
    "@types/react": "19.1.10",
    "babel-preset-expo": "~54.0.10",
    "convex-test": "^0.0.60",
    "react-native-dotenv": "^3.4.11",
    "tsx": "^4.20.5",
    "typescript": "^5.5.4",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "8.5.26"
  }
}
